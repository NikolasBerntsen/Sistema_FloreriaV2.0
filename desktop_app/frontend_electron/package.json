{
  "name": "frontend_electron",
  "version": "0.1.0",
  "description": "Frontend Electron para Florería Carlitos",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -p \"{name}\" -n BACKEND,RENDERER,ELECTRON -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:desktop": "concurrently -k -p \"{name}\" -n RENDERER,ELECTRON -c green,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:backend": "cross-env PYTHONUNBUFFERED=1 PYTHONPATH=.. nodemon --quiet --watch ../app --watch ../main.py --watch ../dev_backend.py --ext py --exec \"python ../dev_backend.py\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "cross-env NODE_ENV=production electron-builder",
    "lint": "eslint '{electron,src}/**/*.{js,jsx}'",
    "format": "prettier --write '{electron,src}/**/*.{js,jsx,css,json}'"
  },
  "keywords": [
    "electron",
    "vite",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.1",
    "vite": "^6.0.7",
    "wait-on": "^7.2.0"
  }
}
